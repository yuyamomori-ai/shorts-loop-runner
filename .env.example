# OpenAI is required for production narration, planning and visual/fact verification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
DAILY_AI_CALLS=60
# Local API guard, persistent across restarts. Total target cannot exceed JPY 10,000.
# Keep JPY 4,000 for hosting/tax/FX; provider-level hard limits must also be configured.
SHORTSLOOP_MONTHLY_TOTAL_JPY=10000
SHORTSLOOP_MONTHLY_AI_JPY=6000
# Conservative accounting allowance, not a live FX rate; values below 200 are rejected upward.
SHORTSLOOP_BUDGET_JPY_PER_USD=200
# Audit flags: enable ONLY after the applicable YouTube approval has been obtained.
YOUTUBE_PUBLIC_UPLOAD_APPROVED=false
YOUTUBE_DERIVED_METRICS_APPROVED=false
# Docker binds only to localhost. A public HTTPS reverse proxy must remove this bypass.
TRUST_LOOPBACK_PROXY=false
ENGINE_TOKEN=
# Optional VOICEVOX; blank uses OpenAI TTS. Check the selected voice's license.
VOICEVOX_URL=
VOICEVOX_SPEAKER=3
VOICEVOX_RIGHTS_CONFIRMED=false
VOICEVOX_CREDIT=
CAPTION_FONT=Noto Sans CJK JP
CAPTION_FONT_VERIFIED=false

# Optional licensed stock video discovery (never downloads from social networks).
PEXELS_API_KEY=
# Visual planning is on by default for BOTH knowledge (A) and footage-led (B) videos.
SHORTSLOOP_VISUAL_FIRST=true
# Bound stock downloads/searches and safe visual-only repair attempts per video.
SHORTSLOOP_MAX_ASSETS=3
SHORTSLOOP_VISUAL_REPAIRS=2
# Hold all YouTube sends during deployment acceptance; does not erase the user's mode.
SHORTSLOOP_PUBLISH_HOLD=false
# Optional isolated science + knowledge acceptance run on startup. Never uploads.
SHORTSLOOP_VALIDATE_ON_START=false
SHORTSLOOP_VALIDATION_ID=visual-v1
# External HTTPS runner: set ENGINE_TOKEN, PUBLIC_BASE_URL and keep TRUST_LOOPBACK_PROXY=false.
PUBLIC_BASE_URL=
# Optional 32-byte base64 key; without it, a local 0600 key file is generated.
TOKEN_ENCRYPTION_KEY=
# Enable only if the authenticated account grants the extra monetary scope.
YOUTUBE_REVENUE_SCOPE=false
# Rates are verified in runner/budget.mjs; unknown models stop new paid requests.
# Legacy cost-rate variables no longer override the guard. Unknown past costs require review.

# 接続完了後、追加の開始操作なしで自動運転。停止指示・安全停止は保持します。
AUTO_START_ON_CONNECT=false
YOUTUBE_TARGET_EMAIL=
# Google CloudのWeb用OAuthクライアント（画面からの設定も可）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Small always-on servers: bound encoder concurrency, without changing video size.
FFMPEG_THREADS=2
# Optional generated-media cleanup. 0 keeps completed media locally.
# Only confirmed public videos are eligible; scripts/evidence/metrics and input assets remain.
MEDIA_RETENTION_HOURS=0
MEDIA_BUDGET_MB=0

# 500k+ creator-tagged short-form reference candidates: title/thumbnail observations only.
# Uses connected YouTube OAuth and the existing derived-data approval. No video downloads.
SHORTSLOOP_POPULAR_REFERENCES=true
# At most this many official discovery searches per day; each new plan refreshes selected IDs.
SHORTSLOOP_BENCHMARK_SEARCHES=2

# Optional, time-limited read-only access to newly generated acceptance artifacts only.
SHORTSLOOP_VALIDATION_TOKEN=
SHORTSLOOP_VALIDATION_ACCESS_EXPIRES=

# Explicit owner authorization for public autoposting; a new request ID applies once.
# Existing safety stops remain; Google can still restrict an unaudited API project.
# New installations default to public visibility but remain paused until configured.
SHORTSLOOP_PUBLIC_AUTOPILOT_REQUEST=
