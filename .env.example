# Optional. Without a key, create curated drafts and subtitle-only previews.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
DAILY_AI_CALLS=60
# Enable ONLY after the applicable YouTube audit/approval has been obtained.
YOUTUBE_PUBLIC_UPLOAD_APPROVED=false
YOUTUBE_DERIVED_METRICS_APPROVED=false
# Docker binds only to localhost. A public HTTPS reverse proxy must remove this bypass.
TRUST_LOOPBACK_PROXY=false
ENGINE_TOKEN=
# Optional VOICEVOX; blank uses OpenAI TTS. Check the selected voice's license.
VOICEVOX_URL=
VOICEVOX_SPEAKER=3
VOICEVOX_RIGHTS_CONFIRMED=false
VOICEVOX_CREDIT=
CAPTION_FONT=Noto Sans CJK JP
CAPTION_FONT_VERIFIED=false

# Optional licensed stock video discovery (never downloads from social networks).
PEXELS_API_KEY=
# When Pexels is configured, prefer visual-first TYPE B videos in automatic generation.
SHORTSLOOP_VISUAL_FIRST=true
# External HTTPS runner: set ENGINE_TOKEN, PUBLIC_BASE_URL and keep TRUST_LOOPBACK_PROXY=false.
PUBLIC_BASE_URL=
# Optional 32-byte base64 key; without it, a local 0600 key file is generated.
TOKEN_ENCRYPTION_KEY=
# Enable only if the authenticated account grants the extra monetary scope.
YOUTUBE_REVENUE_SCOPE=false
# Optional known rates; blank means cost is unknown, never zero.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
TTS_USD_PER_MILLION_CHARACTERS=

# 接続完了後、追加の開始操作なしで自動運転。停止指示・安全停止は保持します。
AUTO_START_ON_CONNECT=false
YOUTUBE_TARGET_EMAIL=
# Google CloudのWeb用OAuthクライアント（画面からの設定も可）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Small always-on servers: bound encoder concurrency, without changing video size.
FFMPEG_THREADS=2
# Optional generated-media cleanup. 0 keeps completed media locally.
# Only confirmed public videos are eligible; scripts/evidence/metrics and input assets remain.
MEDIA_RETENTION_HOURS=0
MEDIA_BUDGET_MB=0
