FROM node:24-bookworm-slim AS ui
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --include=dev --no-audit --no-fund
COPY . .
RUN node --check runner/server.mjs
RUN node --test tests/acceptance-preflight.test.mjs tests/generated-media.test.mjs tests/planning.test.mjs tests/source-facts.test.mjs tests/engine.test.mjs tests/automation.test.mjs tests/production-loop.test.mjs tests/presentation-repair.test.mjs tests/originality-context.test.mjs tests/budget.test.mjs tests/media-policy.test.mjs tests/promote-validation.test.mjs tests/queue-recovery.test.mjs tests/operational-status.test.mjs
RUN npm run build:local

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-noto-cjk fontconfig ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY runner ./runner
COPY lib ./lib
COPY --from=ui /app/local-dist ./local-dist
ENV HOST=0.0.0.0 PORT=8787 DATA_DIR=/app/data
EXPOSE 8787
CMD ["node", "runner/server.mjs"]
